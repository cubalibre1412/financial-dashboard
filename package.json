{
  "name": "financial-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data:check": "node scripts/refresh-data.mjs",
    "audit:context": "node scripts/audit-company-context.mjs",
    "verify:downloads": "node scripts/verify-downloads.mjs",
